<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Kkindle.FeedbackWindow" Title="{DynamicResource Ui.Feedback.Title}"
        Width="560" SizeToContent="Height" MaxHeight="820" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PaperBrush}"
        FontFamily="{StaticResource DefaultAppFontFamily}">
  <Window.Styles>
    <Style Selector="TextBlock"><Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" /></Style>
    <Style Selector="TextBox"><Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" /></Style>
    <Style Selector="ComboBox"><Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" /></Style>
    <Style Selector="Button"><Setter Property="FontFamily" Value="{StaticResource DefaultAppFontFamily}" /></Style>
    <Style Selector="TextBlock.feedbackLabel">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.feedbackHint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.feedbackPanel">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14" />
    </Style>
  </Window.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Spacing="14">
      <TextBlock Text="{DynamicResource Ui.Feedback.Title}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{DynamicResource Ui.Feedback.Introduction}" FontSize="13" TextWrapping="Wrap" />
      <TextBlock Text="{DynamicResource Ui.Feedback.PrivacyNote}" Classes="feedbackHint" />

      <Border x:Name="LoginPanel" Classes="feedbackPanel" IsVisible="False">
        <StackPanel Spacing="10">
          <TextBlock x:Name="LoginNoticeText" Text="{DynamicResource Ui.Feedback.LoginRequired}" FontSize="13" TextWrapping="Wrap" />
          <Button x:Name="OpenAccountCenterButton" Content="{DynamicResource Ui.Feedback.OpenAccountCenter}"
                  HorizontalAlignment="Left" Click="OnOpenAccountCenterClick" />
        </StackPanel>
      </Border>

      <StackPanel x:Name="FormPanel" Spacing="14">
        <TextBlock x:Name="AccountLabel" Classes="feedbackHint" IsVisible="False" />

        <StackPanel Spacing="6">
          <TextBlock Text="{DynamicResource Ui.Feedback.Type}" Classes="feedbackLabel" />
          <ComboBox x:Name="TypeBox" HorizontalAlignment="Stretch" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="{DynamicResource Ui.Feedback.Description}" Classes="feedbackLabel" />
          <TextBox x:Name="ContentBox"
                   AcceptsReturn="True"
                   MinHeight="140"
                   MaxLength="4000"
                   TextWrapping="Wrap"
                   VerticalContentAlignment="Top"
                   PlaceholderText="{DynamicResource Ui.Feedback.DescriptionWatermark}"
                   TextChanged="OnContentChanged" />
          <TextBlock x:Name="ContentCountText" Classes="feedbackHint" HorizontalAlignment="Right" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="{DynamicResource Ui.Feedback.Contact}" Classes="feedbackLabel" />
          <TextBox x:Name="ContactBox" MaxLength="100" PlaceholderText="{DynamicResource Ui.Feedback.ContactWatermark}" />
        </StackPanel>

        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="{DynamicResource Ui.Feedback.Screenshots}" Classes="feedbackLabel" VerticalAlignment="Center" />
            <Button x:Name="AddScreenshotButton" Grid.Column="1" Content="{DynamicResource Ui.Feedback.AddScreenshot}"
                    Classes="quiet" Click="OnAddScreenshotClick" />
          </Grid>
          <TextBlock Text="{DynamicResource Ui.Feedback.ScreenshotHint}" Classes="feedbackHint" />
          <WrapPanel x:Name="ScreenshotPanel" Orientation="Horizontal" />
        </StackPanel>

        <StackPanel Spacing="6">
          <CheckBox x:Name="AttachSoftwareLogCheckBox" Content="{DynamicResource Ui.Feedback.AttachLogs}" IsChecked="True" />
          <TextBlock Text="{DynamicResource Ui.Feedback.AttachLogsHint}" Classes="feedbackHint" />
        </StackPanel>

        <TextBlock x:Name="StatusText" IsVisible="False" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedInkBrush}" />

        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
          <Button x:Name="CloseButton" Content="{DynamicResource Ui.Feedback.Close}" Click="OnCloseClick" />
          <Button x:Name="SubmitButton" Content="{DynamicResource Ui.Feedback.Submit}" Click="OnSubmitClick" />
        </StackPanel>
      </StackPanel>

      <Border x:Name="SuccessPanel" Classes="feedbackPanel" IsVisible="False">
        <StackPanel Spacing="10">
          <TextBlock Text="{DynamicResource Ui.Feedback.SuccessTitle}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="SuccessNumberText" FontSize="13" TextWrapping="Wrap" />
          <TextBlock Text="{DynamicResource Ui.Feedback.SuccessHint}" Classes="feedbackHint" />
          <Button Content="{DynamicResource Ui.Feedback.Close}" HorizontalAlignment="Right" Click="OnCloseClick" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
