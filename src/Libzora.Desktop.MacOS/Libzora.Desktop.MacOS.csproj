<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Libzora.Desktop.MacOS</RootNamespace>
    <AssemblyName>Libzora</AssemblyName>
    <Product>Libzora</Product>
    <Authors>kingstacker</Authors>
    <RuntimeIdentifiers>osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <None Update="Info.plist" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\Libzora.App\Libzora.App.csproj" />
    <ProjectReference Include="..\Libzora.Infrastructure\Libzora.Infrastructure.csproj" />
    <ProjectReference Include="..\Libzora.Platform.MacOS\Libzora.Platform.MacOS.csproj" />
    <ProjectReference Include="..\Libzora.Tts.Sherpa\Libzora.Tts.Sherpa.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
  </ItemGroup>
</Project>
