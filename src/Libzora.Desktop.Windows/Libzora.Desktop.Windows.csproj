<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Thin platform head: owns Main, picks the Windows implementations of the
         Libzora.Core platform interfaces, and hands them to the portable UI in
         Libzora.App. All UI code lives there; nothing but wiring belongs here.
         A Linux or macOS head is a sibling of this project. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Libzora.Desktop.Windows</RootNamespace>
    <AssemblyName>Libzora</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Libzora.App\Assets\Icons\Libzora.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <Product>Libzora</Product>
    <Authors>kingstacker</Authors>
    <RepositoryUrl>https://github.com/kingstacker/Libzora</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Libzora.App\Libzora.App.csproj" />
    <ProjectReference Include="..\Libzora.Core\Libzora.Core.csproj" />
    <ProjectReference Include="..\Libzora.Platform.Windows\Libzora.Platform.Windows.csproj" />
    <ProjectReference Include="..\Libzora.Tts.Sherpa\Libzora.Tts.Sherpa.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <Content Include="..\Libzora.App\Assets\Icons\Libzora.ico" Link="Assets\Libzora.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
