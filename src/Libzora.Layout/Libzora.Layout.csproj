<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Font identity helpers and the installed-font registry live in Core so
         both the reader and the platform font catalogs share one definition. -->
    <ProjectReference Include="..\Libzora.Core\Libzora.Core.csproj" />
    <!-- The SkiaSharp/HarfBuzzSharp metapackages only declare Win32 and macOS
         natives; the Linux native libraries must be referenced explicitly or
         the engine cannot shape or rasterize on Linux. -->
    <PackageReference Include="HarfBuzzSharp" Version="8.3.1.3" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.3" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Text/Hyphenation/hyph-en-us.pat.txt" LogicalName="Libzora.Hyphenation.en-us.patterns" />
    <EmbeddedResource Include="Text/Hyphenation/hyph-en-us.hyp.txt" LogicalName="Libzora.Hyphenation.en-us.exceptions" />
    <EmbeddedResource Include="../Libzora.Infrastructure/ThirdParty/Notices/components/EnglishHyphenation/LICENSE.txt"
                      LogicalName="Libzora.Hyphenation.en-us.license" />
  </ItemGroup>

</Project>
