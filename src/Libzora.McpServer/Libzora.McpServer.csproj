<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <RootNamespace>Libzora.McpServer</RootNamespace>
    <AssemblyName>Libzora.McpServer</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Libzora.Core\Libzora.Core.csproj" />
    <ProjectReference Include="..\Libzora.Infrastructure\Libzora.Infrastructure.csproj" />
    <ProjectReference Include="..\Libzora.Platform.Common\Libzora.Platform.Common.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <ProjectReference Include="..\Libzora.Platform.Windows\Libzora.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\Libzora.Platform.MacOS\Libzora.Platform.MacOS.csproj" />
  </ItemGroup>
</Project>
