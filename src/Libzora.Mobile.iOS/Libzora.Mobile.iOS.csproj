<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- iOS owns its SwiftUI frontend; shared services and the reader renderer
         continue to live in Libzora.Mobile / ApplicationModules. -->
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>Libzora.iOSHead</RootNamespace>
    <AssemblyName>Libzora.Mobile.iOS</AssemblyName>
    <ApplicationId>com.kingstacker.libzora</ApplicationId>
    <ApplicationTitle>Libzora</ApplicationTitle>
    <AppIcon>Libzora</AppIcon>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.1.3</ApplicationDisplayVersion>
    <!-- Intel Macs are capped at Xcode 26, while the current .NET iOS
         workload targets Xcode 27.1. Skip its version gate and link only SDK
         assemblies: the shared UI calls no iOS 27-only API. -->
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
    <MtouchLink>SdkOnly</MtouchLink>
    <RuntimeIdentifiers>iossimulator-x64;iossimulator-arm64;ios-arm64</RuntimeIdentifiers>
    <UseSwiftUIFrontend Condition="'$(UseSwiftUIFrontend)' == ''">true</UseSwiftUIFrontend>
    <Registrar Condition="'$(UseSwiftUIFrontend)' == 'true'">static</Registrar>
    <DefineConstants Condition="'$(UseSwiftUIFrontend)' == 'true'">$(DefineConstants);LIBZORA_SWIFT_UI</DefineConstants>
    <NativeSwiftOutput>$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/native-ui</NativeSwiftOutput>
    <!-- WidgetKit extensions share an App Group with the phone app. Device
         builds need a provisioning profile that includes
         group.com.kingstacker.libzora; pass -p:EnableWidgets=false to build a
         profile-less diagnostic app instead. -->
    <EnableWidgets Condition="'$(EnableWidgets)' == ''">true</EnableWidgets>
    <WidgetBundleId Condition="'$(WidgetBundleId)' == ''">com.kingstacker.libzora.widgets</WidgetBundleId>
    <!-- Optional path to the widget extension's provisioning profile. Device
         builds must pass it when the generated extension is signed, otherwise
         the app installs but widget discovery cannot open the extension. -->
    <WidgetProvisioningProfile Condition="'$(WidgetProvisioningProfile)' == ''"></WidgetProvisioningProfile>
    <WidgetSwiftOutput>$(NativeSwiftOutput)-widgets</WidgetSwiftOutput>
    <CodesignEntitlements Condition="'$(EnableWidgets)' == 'true' And '$(RuntimeIdentifier)' != '' And '$(CodesignEntitlements)' == ''">$(MSBuildProjectDirectory)/Entitlements.plist</CodesignEntitlements>
    <WidgetBuildScript>$(MSBuildProjectDirectory)/../../src/Libzora.Widgets/build-ios-widgets.sh</WidgetBuildScript>
    <WidgetSourceRoot>$(MSBuildProjectDirectory)/../../src/Libzora.Widgets/Shared</WidgetSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- Share the real Icon Composer layers with macOS. ACTool emits the
         Liquid Glass rendition and the fallback for iOS 15–25 together. -->
    <ImageAsset Remove="Assets.xcassets/AppIcon.appiconset/**" />
    <ImageAsset Include="../../scripts/macos/Libzora.icon/**/*"
                Exclude="../../scripts/macos/Libzora.icon/**/.DS_Store"
                Link="Libzora.icon/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The reader's typesetter opens this font by filesystem path. An
         AvaloniaResource alone embeds it in an assembly, not in the app bundle. -->
    <BundleResource Include="..\Libzora.App\Assets\Fonts\KingHwaOldSong-v3.0.ttf"
                    LogicalName="Assets/Fonts/KingHwaOldSong-v3.0.ttf" />
    <!-- iOS has no readable system font directory; bundle the symbol/emoji
         fallbacks so missing glyphs do not become .notdef boxes on device. -->
    <BundleResource Include="..\Libzora.App\Assets\Fonts\NotoEmoji.ttf"
                    LogicalName="Assets/Fonts/NotoEmoji.ttf" />
    <BundleResource Include="..\Libzora.App\Assets\Fonts\NotoSansSymbols2-Regular.ttf"
                    LogicalName="Assets/Fonts/NotoSansSymbols2-Regular.ttf" />
    <!-- OFL 1.1 requires the license text to travel with the fonts. -->
    <BundleResource Include="..\Libzora.App\Assets\Fonts\NotoEmoji-LICENSE.txt"
                    LogicalName="Assets/Fonts/NotoEmoji-LICENSE.txt" />
    <BundleResource Include="..\Libzora.App\Assets\Fonts\NotoSansSymbols2-LICENSE.txt"
                    LogicalName="Assets/Fonts/NotoSansSymbols2-LICENSE.txt" />
    <!-- Preserve original third-party notices in the native app bundle too. -->
    <BundleResource Include="../../LICENSE" LogicalName="LICENSE" />
    <BundleResource Include="../../THIRD-PARTY-NOTICES.md" LogicalName="THIRD-PARTY-NOTICES.md" />
    <BundleResource Include="../Libzora.Infrastructure/ThirdParty/Notices/**/*"
                    LogicalName="ThirdParty/Notices/%(RecursiveDir)%(Filename)%(Extension)" />
    <BundleResource Include="../Libzora.Infrastructure/ThirdParty/MdxParser/*.md;../Libzora.Infrastructure/ThirdParty/MdxParser/*.txt;../Libzora.Infrastructure/ThirdParty/MdxParser/*.html"
                    LogicalName="ThirdParty/MdxParser/%(Filename)%(Extension)" />
    <BundleResource Include="../Libzora.Infrastructure/ThirdParty/KindleUnpack/*"
                    LogicalName="ThirdParty/KindleUnpack/%(Filename)%(Extension)" />
    <BundleResource Include="../Libzora.Infrastructure/ThirdParty/PDFium/**/*"
                    LogicalName="ThirdParty/PDFium/%(RecursiveDir)%(Filename)%(Extension)" />
    <BundleResource Include="../Libzora.Infrastructure/ThirdParty/G2PW/LICENSE.txt;../Libzora.Infrastructure/ThirdParty/G2PW/NOTICE.md"
                    LogicalName="ThirdParty/G2PW/%(Filename)%(Extension)" />
    <BundleResource Include="../Libzora.App/Assets/Fonts/KingHwaOldSong-LICENSE.txt"
                    LogicalName="Assets/Fonts/KingHwaOldSong-LICENSE.txt" />
    <!-- Optional reader fonts. Debug builds bundle the local catalog populated
         by scripts/fetch-reader-fonts.sh; release builds fetch the same files
         from ReaderFontCatalog.RemoteBaseUrl instead. -->
    <BundleResource Include="../Libzora.App/Assets/Fonts/catalog/*.ttf;../Libzora.App/Assets/Fonts/catalog/*.otf"
                    LogicalName="Assets/Fonts/catalog/%(Filename)%(Extension)"
                    Condition="'$(Configuration)' == 'Debug' And Exists('../Libzora.App/Assets/Fonts/catalog')" />
    <BundleResource Include="../Libzora.App/Assets/Fonts/catalog/licenses/*"
                    LogicalName="Assets/Fonts/catalog/licenses/%(Filename)%(Extension)"
                    Condition="Exists('../Libzora.App/Assets/Fonts/catalog/licenses')" />
    <BundleResource Include="../Libzora.App/Assets/Icons/Lucide-LICENSE.txt"
                    LogicalName="Assets/Icons/Lucide-LICENSE.txt" />
    <ProjectReference Include="..\Libzora.Mobile\Libzora.Mobile.csproj" />
    <PackageReference Include="Avalonia.iOS" Version="12.1.1" />
    <!-- SkiaSharp only pulls its iOS native framework through its
         net10.0-ios26.2 dependency group. Device builds pinned to an older
         iOS SDK (Intel Macs that cannot run Xcode 27) fall back to the plain
         net10.0 group, so request the framework explicitly. -->
    <PackageReference Include="SkiaSharp.NativeAssets.iOS" Version="3.119.4" />
    <!-- Local embeddings back the desktop AI features. The managed assembly is
         referenced by Libzora.Infrastructure, so its native framework must be
         linked here even though the phone app does not expose AI yet. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" ExcludeAssets="native" />
    <!-- PDFium matches the Android head so PDF reading and text selection work
         on both platforms. -->
    <PackageReference Include="bblanchon.PDFium.iOS" Version="152.0.7961" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseSwiftUIFrontend)' == 'true'">
    <PartialAppManifest Include="NativeUI/SceneManifest.plist" />
    <SwiftFrontendSource Include="NativeUI/*.swift" />
    <NativeReference Include="$(NativeSwiftOutput)/libLibzoraNativeUI.a"
                     Kind="Static" ForceLoad="true" SmartLink="false"
                     Frameworks="SwiftUI UIKit Foundation WidgetKit"
                     LinkWithSwiftSystemLibraries="true" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableWidgets)' == 'true' And '$(RuntimeIdentifier)' != ''">
    <SwiftWidgetSource Include="$(WidgetSourceRoot)/*.swift" />
    <WidgetFontResource Include="../Libzora.App/Assets/Fonts/KingHwaOldSong-v3.0.ttf;../Libzora.App/Assets/Fonts/KingHwaOldSong-LICENSE.txt" />
    <!-- The .NET iOS SDK copies and signs these additional app extensions. -->
    <AdditionalAppExtensions Include="$(WidgetSwiftOutput)">
      <BuildOutput>.</BuildOutput>
      <Name>LibzoraWidgets</Name>
      <CodesignEntitlements>$(MSBuildProjectDirectory)/../../src/Libzora.Widgets/LibzoraWidgets.iOS.entitlements</CodesignEntitlements>
    </AdditionalAppExtensions>
  </ItemGroup>

  <Target Name="BuildSwiftFrontend" BeforeTargets="_ExpandNativeReferences"
          Condition="'$(UseSwiftUIFrontend)' == 'true' And '$(RuntimeIdentifier)' != ''"
          Inputs="@(SwiftFrontendSource);NativeUI/build-native-ui.sh"
          Outputs="$(NativeSwiftOutput)/libLibzoraNativeUI.a">
    <Exec Command="/bin/zsh &quot;$(MSBuildProjectDirectory)/NativeUI/build-native-ui.sh&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(NativeSwiftOutput)&quot; &quot;$(Configuration)&quot;" />
  </Target>

  <Target Name="BuildSwiftWidgets" BeforeTargets="_ExtendAppExtensionReferences"
          Condition="'$(EnableWidgets)' == 'true' And '$(RuntimeIdentifier)' != ''"
          Inputs="@(SwiftWidgetSource);@(WidgetFontResource);$(WidgetBuildScript)"
          Outputs="$(WidgetSwiftOutput)/LibzoraWidgets.appex/LibzoraWidgets">
    <Exec Command="/bin/zsh &quot;$(WidgetBuildScript)&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(WidgetSwiftOutput)&quot; &quot;$(Configuration)&quot; &quot;$(WidgetBundleId)&quot; &quot;$(ApplicationDisplayVersion)&quot; &quot;$(ApplicationVersion)&quot;" />
  </Target>

  <Target Name="EmbedWidgetProvisioningProfile" DependsOnTargets="BuildSwiftWidgets"
          BeforeTargets="_ExtendAppExtensionReferences"
          Condition="'$(EnableWidgets)' == 'true' And '$(RuntimeIdentifier)' != '' And '$(WidgetProvisioningProfile)' != ''">
    <Error Text="WidgetProvisioningProfile does not exist: $(WidgetProvisioningProfile)"
           Condition="!Exists('$(WidgetProvisioningProfile)')" />
    <Copy SourceFiles="$(WidgetProvisioningProfile)"
          DestinationFiles="$(WidgetSwiftOutput)/LibzoraWidgets.appex/embedded.mobileprovision" />
  </Target>
</Project>
