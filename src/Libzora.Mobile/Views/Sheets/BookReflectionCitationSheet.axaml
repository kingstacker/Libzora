<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:Libzora.Core"
             x:Class="Libzora.Mobile.Views.Sheets.BookReflectionCitationSheet">
  <Grid RowDefinitions="Auto,*" RowSpacing="12">
    <TextBox Name="SearchBox"
             Classes="field"
             PlaceholderText="搜索书名、章节、划线或批注"
             TextChanged="OnSearchTextChanged" />
    <Panel Grid.Row="1">
      <ScrollViewer MaxHeight="420">
        <ItemsControl Name="CitationList">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="core:BookReflectionCitationRecord">
              <Button Classes="row"
                      Padding="12,10"
                      Margin="0,0,0,6"
                      Background="{DynamicResource SunkBrush}"
                      CornerRadius="10"
                      Click="OnCitationClick">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding DisplayText}"
                             FontSize="14"
                             LineHeight="20"
                             MaxLines="3"
                             TextTrimming="CharacterEllipsis"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding BookTitle}"
                             Classes="muted"
                             FontSize="12"
                             MaxLines="1"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock Name="EmptyText"
                 Text="没有找到匹配的批注。"
                 Classes="muted"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="0,32"
                 IsVisible="False" />
    </Panel>
  </Grid>
</UserControl>
