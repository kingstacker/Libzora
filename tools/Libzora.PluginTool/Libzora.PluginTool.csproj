<Project Sdk="Microsoft.NET.Sdk">
  <!-- Command-line helper for plugin authors: validate, pack, sign and
       publish Libzora plugins. Uses the app's own manifest, package and
       signature code so its verdicts match what the app will accept.
       Run: dotnet run (project tools/Libzora.PluginTool) help -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>libzora-plugin</AssemblyName>
    <RootNamespace>Libzora.PluginTool</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Libzora.Infrastructure\Libzora.Infrastructure.csproj" />
  </ItemGroup>
</Project>
